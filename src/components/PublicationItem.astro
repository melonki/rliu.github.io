---
import type { Publication } from "../data/publications";
import ScientificText from "./ScientificText.astro";

interface Props {
  publication: Publication;
  compact?: boolean;
  showMetrics?: boolean;
}

const { publication, compact = false, showMetrics = false } = Astro.props;
const authorParts = publication.authors.split(/(Liu, R\.)/g);
const doi = publication.doi.replace(/^https?:\/\/(?:dx\.)?doi\.org\//, "");
---

<article class:list={["publication", { "publication-compact": compact }]}>
  <div class="publication-heading">
    <h3><a href={publication.doi} target="_blank" rel="noreferrer"><ScientificText text={publication.title} /></a></h3>
  </div>
  <p class="publication-authors">
    {authorParts.map((part) => part === "Liu, R." ? <strong>{part}</strong> : part)}
  </p>
  <p class="publication-meta">
    <em>{publication.venue}</em>{publication.details && `, ${publication.details}`}
    {publication.firstAuthor && <span class="tag">First author</span>}
    {publication.equalContribution && <span class="tag">Equal contribution</span>}
    {publication.note && <span class="tag">{publication.note}</span>}
    {showMetrics && (
      <span class="publication-metrics" aria-label={`Citation metrics for ${publication.title}`}>
        <span
          class="__dimensions_badge_embed__"
          data-doi={doi}
          data-style="small_rectangle"
          data-legend="hover-right"
          data-hide-zero-citations="true"
        />
      </span>
    )}
  </p>
</article>
