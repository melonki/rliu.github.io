---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScientificText from "../components/ScientificText.astro";
import {
  appointments,
  cvFile,
  conferencePresentations,
  education,
  reviewingJournals,
} from "../data/site";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="CV"
  currentPath="cv/"
  description="Curriculum vitae and academic background for Riyang Liu at Duke University."
>
  <header class="page-header cv-header">
    <div>
      <h1>Curriculum vitae</h1>
    </div>
    <a class="button button-primary" href={`${base}${cvFile}`}>Download CV (PDF)</a>
  </header>

  <section class="cv-section" aria-labelledby="appointments-heading">
    <h2 id="appointments-heading">Appointments</h2>
    <div class="timeline-list">
      {appointments.map((appointment) => (
        <article class="timeline-item">
          <div class="timeline-date">{appointment.dates}</div>
          <div>
            <h3>{appointment.institution}</h3>
            <p class="timeline-title">{appointment.title}</p>
            <p>
              {appointment.relationships.label}: {
                appointment.relationships.people.map((person, index) => (
                  <>
                    {index > 0 && (index === appointment.relationships.people.length - 1 ? " and " : ", ")}
                    <a href={person.url} target="_blank" rel="noreferrer">{person.name}</a>
                  </>
                ))
              } · {appointment.location}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <div class="timeline-list">
      {education.map((item) => (
        <article class="timeline-item">
          <div class="timeline-date">{item.dates}</div>
          <div>
            <h3>{item.institution}</h3>
            <p class="timeline-title">{item.degree}</p>
            {item.relationships && (
              <p>
                {item.relationships.label}: {
                  item.relationships.people.map((person, index) => (
                    <>
                      {index > 0 && (index === item.relationships.people.length - 1 ? " and " : ", ")}
                      <a href={person.url} target="_blank" rel="noreferrer">{person.name}</a>
                    </>
                  ))
                }
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section" aria-labelledby="service-heading">
    <h2 id="service-heading">Professional service</h2>
    <h3 class="service-subheading">Peer reviewer</h3>
    <ul class="service-list">
      {reviewingJournals.map((journal) => <li>{journal}</li>)}
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="presentations-heading">
    <h2 id="presentations-heading">Conference presentations</h2>
    <div class="timeline-list">
      {conferencePresentations.map((presentation) => (
        <article class="timeline-item">
          <div class="timeline-date">{presentation.date}</div>
          <div>
            <h3><ScientificText text={presentation.title} /></h3>
            <p class="timeline-title">{presentation.event}</p>
            <p>{presentation.location} · {presentation.format}</p>
            {presentation.material && (
              <p class="presentation-link">
                <a href={presentation.material.url} target="_blank" rel="noreferrer">
                  {presentation.material.label} <span aria-hidden="true">↗</span>
                </a>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
