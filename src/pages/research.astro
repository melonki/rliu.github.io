---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScientificText from "../components/ScientificText.astro";
import { researchIntroduction, researchSummary } from "../data/site";
---

<BaseLayout
  title="Research"
  currentPath="research/"
  description={researchIntroduction[0]}
>
  <header class="page-header">
    <h1>Research</h1>
    <p class="page-lede">{researchIntroduction.join(" ")}</p>
  </header>

  <div class="research-prose">
    {researchSummary.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p><ScientificText text={paragraph} /></p>)}
      </section>
    ))}
  </div>
</BaseLayout>
