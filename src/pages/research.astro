---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScientificText from "../components/ScientificText.astro";
import { eekhUrl, researchIntroduction, researchSummary } from "../data/site";

const eekhName = "Environmental Exposures & Kidney Health";
---

<BaseLayout
  title="Research"
  currentPath="research/"
  description={researchIntroduction[0]}
>
  <header class="page-header">
    <h1>Research</h1>
    <p class="page-lede">{researchIntroduction.join(" ")}</p>
  </header>

  <div class="research-prose">
    {researchSummary.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => {
          const [beforeLink, afterLink] = paragraph.split(eekhName);
          return <p>
            {afterLink === undefined ? (
              <ScientificText text={paragraph} />
            ) : (
              <>
                <ScientificText text={beforeLink} />
                <a href={eekhUrl} target="_blank" rel="noreferrer">{eekhName}</a>
                <ScientificText text={afterLink} />
              </>
            )}
          </p>;
        })}
      </section>
    ))}
  </div>
</BaseLayout>
